# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/marjad

# NextAuth
AUTH_SECRET=your-random-secret-here
AUTH_URL=http://localhost:3000

# Redis — required in production for rate limits shared across app instances
# Local development falls back to an in-process limiter when this is empty.
REDIS_URL=redis://localhost:6379

# Load test overrides (optional; defaults are intentionally lightweight)
LOAD_BASE_URL=http://localhost:3000
LOAD_READ_REQUESTS=100
LOAD_READ_CONCURRENCY=10
LOAD_CHECKOUT_REQUESTS=6
LOAD_CHECKOUT_CONCURRENCY=3
LOAD_READ_P95_MS=1000
LOAD_CHECKOUT_P95_MS=1500
LOAD_MAX_ERROR_RATE=0.01

# Admin QA target (optional)
ADMIN_QA_BASE_URL=http://localhost:3000

# Deployment verification
APP_ENV=development
DEPLOY_ENV_FILE=.env.local
DEPLOY_VERIFY_URL=http://localhost:3000
# Staging only: runs smoke, concurrency, load, and admin suites.
DEPLOY_RUN_FULL_QA=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp — international format without + (e.g. 212612345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=212XXXXXXXXX
# Support phone — displayed in footer and contact page (e.g. +212 6 12 34 56 78)
NEXT_PUBLIC_SUPPORT_PHONE=

# Marketing pixels (optional, public IDs only)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_TAG_ID=
NEXT_PUBLIC_ANALYTICS_DEBUG=false
