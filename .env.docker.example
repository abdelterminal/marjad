# Copy to .env before running Docker Compose, then replace secrets.

APP_PORT=3000
UPLOADS_PATH=./public/uploads
APP_MEMORY_LIMIT=768m
TOOLS_MEMORY_LIMIT=768m
POSTGRES_MEMORY_LIMIT=768m
REDIS_MEMORY_LIMIT=256m

POSTGRES_DB=marjad
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:replace-with-strong-password@postgres:5432/marjad
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

REDIS_PORT=6379
REDIS_URL=redis://redis:6379

AUTH_SECRET=replace-with-openssl-rand-hex-32
AUTH_URL=http://localhost:3000

ADMIN_EMAIL=admin@marjad.ma
ADMIN_PASSWORD=replace-with-strong-password
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_WHATSAPP_NUMBER=212XXXXXXXXX
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_TAG_ID=
NEXT_PUBLIC_ANALYTICS_DEBUG=false
